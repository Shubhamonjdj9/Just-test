NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/atelier_store
# Replace with a random secret of at least 32 bytes; never commit your actual .env.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_a_razorpay_webhook_secret
# Optional Cloudinary uploads (when unset, the admin can enter an image URL).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional transactional email. Password-reset emails require SMTP to be configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=store@example.test
# Used only when running the explicit, one-time create:admin command.
ADMIN_EMAIL=
ADMIN_PASSWORD=
